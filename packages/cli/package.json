{
  "name": "@mailsink/cli",
  "version": "0.1.0",
  "description": "Command-line client for a self-hosted Mailsink email sink.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mailsink": "dist/index.js"
  },
  "files": [
    "dist",
    "USAGE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --external:@napi-rs/keyring --external:commander --external:picocolors --outfile=dist/index.js",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@mailsink/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
